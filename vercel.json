{
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/(.*\\.html)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/(brand|produk|about|ai|dokumentasi)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/oauth/callback"
    }
  ],
  "redirects": [
    {
      "destination": "/brand",
      "permanent": true,
      "source": "/brand.html"
    },
    {
      "destination": "/produk",
      "permanent": true,
      "source": "/produk.html"
    },
    {
      "destination": "/about",
      "permanent": true,
      "source": "/about.html"
    },
    {
      "destination": "/ai",
      "permanent": true,
      "source": "/ai.html"
    },
    {
      "destination": "/dokumentasi",
      "permanent": true,
      "source": "/dokumentasi.html"
    }
  ],
  "rewrites": [
    {
      "destination": "/brand.html",
      "source": "/brand"
    },
    {
      "destination": "/produk.html",
      "source": "/produk"
    },
    {
      "destination": "/about.html",
      "source": "/about"
    },
    {
      "destination": "/ai.html",
      "source": "/ai"
    },
    {
      "destination": "/dokumentasi.html",
      "source": "/dokumentasi"
    },
    {
      "destination": "/oauth-callback.html",
      "source": "/oauth/callback"
    }
  ]
}